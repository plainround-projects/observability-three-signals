# Copy to .env (make up does this) and change anything you like. Local-only values; nothing here is a real secret.
POSTGRES_PASSWORD=local-only-admin
ORDERS_READER_PASSWORD=local-only-reader
GRAFANA_ADMIN_PASSWORD=local-only-grafana

# The planted fault: this share of requests makes the order_items query take SLOW_QUERY_SECONDS longer.
SLOW_QUERY_PROBABILITY=0.05
SLOW_QUERY_SECONDS=1.5
# A fixed seed makes the same requests slow on every run; leave empty for a different set each time.
SLOW_QUERY_SEED=20261027

# Host ports (everything is bound to 127.0.0.1 only).
FRONT_HOST_PORT=28081
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
TEMPO_HOST_PORT=3200
LOKI_HOST_PORT=3100
OTLP_HTTP_HOST_PORT=4318
COLLECTOR_HEALTH_HOST_PORT=13133
